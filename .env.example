# ==========================================
# Application / Serveur (Docker & Coolify)
# ==========================================
# NODE_ENV=production
# APP_URL=https://tonssproduction.com

# ==========================================
# Configuration Supabase Auto-Hébergé (Client & SSR)
# ==========================================
# Clé publique (anon) exposée au navigateur via Vite
VITE_SUPABASE_URL=https://supabase.tonssproduction.com
VITE_SUPABASE_ANON_KEY=

# Variables serveur SSR & Admin (SUPABASE_SERVICE_ROLE_KEY = SECRET SERVEUR UNIQUEMENT)
SUPABASE_URL=https://supabase.tonssproduction.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Google Gemini API (Génération SEO côté serveur)
# ==========================================
# SECRET SERVEUR UNIQUEMENT (utilisé dans server/seoAi.ts)
GEMINI_API_KEY=

# ==========================================
# WhatsApp Cloud API (Meta Webhook)
# ==========================================
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ==========================================
# Configuration Serveur SMTP (Envoi d'e-mails)
# ==========================================
# Spaceship / Spacemail (tonssproduction.com)
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@tonssproduction.com
# SECRET SERVEUR UNIQUEMENT
SMTP_PASS=
SMTP_FROM="TONSS Production <contact@tonssproduction.com>"
CONTACT_RECEIVER_EMAIL=contact@tonssproduction.com
